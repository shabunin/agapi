{
  "name": "agapi",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android-tunnel": "adb -d reverse tcp:3000 tcp:3000 && tauri android dev --host 127.0.0.1",
    "build:windows": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "build:android": "tauri android build --apk",
    "build:android:debug": "tauri android build --debug --apk",
    "android:install:debug": "adb install -r src-tauri/gen/android/app/build/outputs/apk/universal/debug/app-universal-debug.apk",
    "android:debug": "npm run build:android:debug && npm run android:install:debug",
    "version:bump": "tsx scripts/bump-version.ts",
    "release": "tsx scripts/release.ts"
  },
  "dependencies": {
    "@agapi/cf-runtime": "0.0.1",
    "@agapi/host-protocol": "0.0.1",
    "@agapi/host-tauri": "0.0.1",
    "@agapi/matterjs": "0.0.1",
    "@agapi/stdlib": "0.0.1",
    "@google/genai": "^1.29.0",
    "@matter/general": "^0.17.7",
    "@matter/protocol": "^0.17.7",
    "@matter/types": "^0.17.7",
    "@pixi/ui": "^2.3.2",
    "@project-chip/matter.js": "^0.17.7",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pixi.js": "^8.18.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
